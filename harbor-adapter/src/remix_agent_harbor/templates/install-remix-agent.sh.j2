#!/usr/bin/env bash
set -euo pipefail

{% if version and version != "latest" %}
REMIX_VERSION="{{ version }}"
DOWNLOAD_URL="https://github.com/hkd987/remix-agent-runtime/releases/download/v${REMIX_VERSION}/remix-agent-x86_64-unknown-linux-gnu.tar.gz"
{% else %}
DOWNLOAD_URL="https://github.com/hkd987/remix-agent-runtime/releases/latest/download/remix-agent-x86_64-unknown-linux-gnu.tar.gz"
{% endif %}

INSTALL_DIR="/usr/local/bin"
TMP_DIR="$(mktemp -d)"

echo "Downloading remix-agent from ${DOWNLOAD_URL}..."
curl -fsSL "${DOWNLOAD_URL}" -o "${TMP_DIR}/remix-agent.tar.gz"

echo "Extracting remix-agent..."
tar -xzf "${TMP_DIR}/remix-agent.tar.gz" -C "${TMP_DIR}"

echo "Installing remix-agent to ${INSTALL_DIR}..."
install -m 755 "${TMP_DIR}/remix-agent" "${INSTALL_DIR}/remix-agent"

echo "Cleaning up..."
rm -rf "${TMP_DIR}"

echo "Verifying installation..."
remix-agent --help > /dev/null 2>&1 && echo "remix-agent installed successfully." || {
    echo "ERROR: remix-agent --help failed" >&2
    exit 1
}
