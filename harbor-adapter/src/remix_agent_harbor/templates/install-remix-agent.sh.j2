#!/usr/bin/env bash
set -euo pipefail

{% if version and version != "latest" %}
REMIX_VERSION="{{ version }}"
DOWNLOAD_URL="https://github.com/hkd987/remix-agent-runtime/releases/download/v${REMIX_VERSION}/remix-agent-x86_64-unknown-linux-musl.tar.gz"
{% else %}
DOWNLOAD_URL="https://github.com/hkd987/remix-agent-runtime/releases/latest/download/remix-agent-x86_64-unknown-linux-musl.tar.gz"
{% endif %}

INSTALL_DIR="/usr/local/bin"
TMP_DIR="$(mktemp -d)"

# Ensure we have a download tool
if ! command -v curl &>/dev/null && ! command -v wget &>/dev/null; then
    echo "Installing curl..."
    apt-get update -qq && apt-get install -y -qq curl >/dev/null 2>&1 || {
        yum install -y curl 2>/dev/null || apk add curl 2>/dev/null || true
    }
fi

# Ensure Python 3 and pip are available (many benchmark tasks require them)
if ! command -v python3 &>/dev/null; then
    echo "Installing Python 3..."
    apt-get update -qq && apt-get install -y -qq python3 python3-pip >/dev/null 2>&1 || {
        yum install -y python3 python3-pip 2>/dev/null || apk add python3 py3-pip 2>/dev/null || true
    }
elif ! command -v pip3 &>/dev/null && ! python3 -m pip --version &>/dev/null 2>&1; then
    echo "Installing pip..."
    apt-get update -qq && apt-get install -y -qq python3-pip >/dev/null 2>&1 || true
fi

echo "Downloading remix-agent from ${DOWNLOAD_URL}..."
if command -v curl &>/dev/null; then
    curl -fsSL --retry 3 --retry-delay 5 "${DOWNLOAD_URL}" -o "${TMP_DIR}/remix-agent.tar.gz"
elif command -v wget &>/dev/null; then
    wget -q --tries=3 --waitretry=5 "${DOWNLOAD_URL}" -O "${TMP_DIR}/remix-agent.tar.gz"
else
    echo "ERROR: Neither curl nor wget available" >&2
    exit 1
fi

echo "Extracting remix-agent..."
tar -xzf "${TMP_DIR}/remix-agent.tar.gz" -C "${TMP_DIR}"

echo "Installing remix-agent to ${INSTALL_DIR}..."
install -m 755 "${TMP_DIR}/remix-agent" "${INSTALL_DIR}/remix-agent"

echo "Cleaning up..."
rm -rf "${TMP_DIR}"

echo "Verifying installation..."
if remix-agent --help >/dev/null 2>&1; then
    echo "remix-agent installed successfully."
else
    # Show the actual error for debugging
    echo "Warning: remix-agent --help returned non-zero. Checking binary..."
    ldd "${INSTALL_DIR}/remix-agent" 2>&1 || file "${INSTALL_DIR}/remix-agent" 2>&1
    # Don't fail — the binary may still work for the actual task
    echo "Proceeding anyway (binary exists at ${INSTALL_DIR}/remix-agent)."
fi
